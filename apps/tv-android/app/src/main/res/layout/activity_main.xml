<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_radial"
    android:keepScreenOn="true">

    <!-- Hardware Accelerated WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_black"
        android:scrollbars="none" />

    <!-- Initial Loading / Connecting Overlay (Matching Figma node 1510:2556) -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_radial"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="visible">

        <!-- Logo Lockup: Bird Mascot + Wordmark -->
        <ImageView
            android:id="@+id/logoLockup"
            android:layout_width="480dp"
            android:layout_height="102dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_minikast_logo" />

        <!-- Dynamic Status Copy (e.g. "Connecting to miniKast.com…") -->
        <TextView
            android:id="@+id/loadingStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="@string/connecting_default"
            android:textColor="@color/text_tertiary_mint"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Error / Connection Lost Overlay -->
    <LinearLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_radial"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="320dp"
            android:layout_height="68dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_minikast_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/network_error_title"
            android:textColor="@color/text_white"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/errorMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxWidth="520dp"
            android:text="@string/network_error_message"
            android:textColor="@color/text_tertiary_mint"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/brand_teal"
                android:focusable="true"
                android:focusedByDefault="true"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/retry_button"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:backgroundTint="@color/card_border"
                android:focusable="true"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/change_server_url"
                android:textColor="@color/text_tertiary_mint"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
